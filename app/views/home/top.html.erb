<div class="home-top">
  <h1>Home#top</h1>

  <%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
    <%= f.text_field :live, placeholder: "地域を入力" %>
    <%= f.submit "検索" %>
  <% end %>

  <div class="room-links">
    <div class="room-card">
      <%= link_to search_rooms_path(live: "東京") do %>
        <%= image_tag "/images/room01.jpg", class: "picture" %>
        <span>東京</span>
      <% end %>
    </div>
    <!-- 他の地域も追加する場合は同じ形式で div.room-card を増やす -->
  </div>
</div>
